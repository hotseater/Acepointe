---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PageHeroVisual from '../components/PageHeroVisual.astro';
import StoryRow from '../components/StoryRow.astro';
import CtaBand from '../components/CtaBand.astro';
import { caseStudies } from '../data/caseStudies';

const stats = [
  { value: '6 wks', label: 'median time to first production release' },
  { value: '100%', label: 'of engagements handed over to client teams' },
  { value: '4', label: 'industries — insurance, healthcare, education, real estate' },
];
---

<BaseLayout
  title="Success stories"
  description="Real outcomes, in production. Every AcePointe engagement shipped to production and was handed over to the client's own team."
>
  <PageHero eyebrow="Success stories">
    <Fragment slot="title">Real outcomes, <span class="accent">in production</span>.</Fragment>
    <Fragment slot="intro">
      Every engagement below shipped to production and was handed over to the client's own team.
      Metrics are theirs, not ours.
    </Fragment>
    <PageHeroVisual variant="stories" slot="visual" />
  </PageHero>

  <section class="stats">
    <div class="container stats__grid">
      {
        stats.map((s) => (
          <div class="stat" data-reveal>
            <span class="stat__value">{s.value}</span>
            <span class="stat__label">{s.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section container stories">
    {caseStudies.map((study, i) => <StoryRow study={study} index={i} />)}
  </section>

  <CtaBand secondaryHref="/approach" secondaryLabel="HOW WE WORK">
    <Fragment slot="title">Your problem could be next.</Fragment>
    <Fragment slot="text">
      Bring us the outcome you've been quoted a multi-quarter program for. We'll come back with a
      shorter path.
    </Fragment>
  </CtaBand>
</BaseLayout>

<style>
  .stats {
    background: var(--surface);
    border-block: 1px solid var(--border);
  }
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    padding-block: 36px;
    text-align: center;
  }
  .stat__value {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.9rem, 1.5rem + 1.5vw, 2.25rem);
    color: var(--brand);
  }
  .stat__label {
    font-size: 14px;
    color: var(--muted);
  }

  .stories {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  @media (max-width: 640px) {
    .stats__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
