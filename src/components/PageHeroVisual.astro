---
/**
 * PageHeroVisual — muted, light SVG for inner-page heroes.
 * No panel/border/shadow: elements sit directly on the light banner (embedded).
 * Soft brand tints + hairline structure; light idle motion only.
 */
type Variant = 'services' | 'stories' | 'whyus' | 'approach';
interface Props {
  variant: Variant;
}
const { variant } = Astro.props;
const labels: Record<Variant, string> = {
  services: 'Six practices, delivered end to end into production',
  stories: 'Real outcomes shipped to production',
  whyus: 'Weeks to production, not quarters',
  approach: 'Embed, build and ship, then transfer',
};
---

<div class="phv" role="img" aria-label={labels[variant]}>
  <svg viewBox="0 0 460 400" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
    <defs>
      <linearGradient id="phvArea" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--brand)" stop-opacity="0.16" />
        <stop offset="1" stop-color="var(--brand)" stop-opacity="0" />
      </linearGradient>
    </defs>

    {variant === 'services' && (
      <g>
        {[
          { y: 40, t: 'STRATEGY & AI CONSULTING' },
          { y: 104, t: 'DATA ENGINEERING' },
          { y: 168, t: 'AI SYSTEMS' },
          { y: 232, t: 'WEB, APP & UX' },
        ].map((row) => (
          <g transform={`translate(40 ${row.y})`}>
            <rect width="380" height="48" rx="12" fill="var(--brand-tint)" />
            <rect width="4" height="48" rx="2" fill="var(--brand)" />
            <text x="26" y="29" class="lbl">{row.t}</text>
            <circle cx="352" cy="24" r="10" fill="#fff" />
            <path d="M347 24 l4 4 l7 -8" stroke="var(--brand)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          </g>
        ))}
        <path d="M52 88 v16 M52 152 v16 M52 216 v16" stroke="var(--brand)" stroke-opacity="0.45" stroke-width="2" stroke-dasharray="3 4" />
        <g transform="translate(40 300)">
          <rect width="380" height="56" rx="14" fill="#fff" stroke="var(--brand)" stroke-opacity="0.5" />
          <circle cx="36" cy="28" r="14" fill="var(--brand)" />
          <path d="M28 28 l6 6 l11 -12" stroke="#fff" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          <text x="64" y="33" class="lbl-lg">Shipped to production</text>
        </g>
      </g>
    )}

    {variant === 'stories' && (
      <g>
        {[
          { x: 30, v: '3.1×', c: 'more qualified leads' },
          { x: 172, v: '82%', c: 'less reporting time' },
          { x: 314, v: '6 wks', c: 'to first feature' },
        ].map((s) => (
          <g transform={`translate(${s.x} 34)`}>
            <rect width="124" height="82" rx="14" fill="var(--brand-tint)" />
            <text x="18" y="46" class="metric">{s.v}</text>
            <text x="18" y="66" class="cap">{s.c}</text>
          </g>
        ))}
        <g transform="translate(0 150)">
          <rect x="30" y="0" width="400" height="206" rx="14" fill="var(--brand-tint)" opacity="0.55" />
          <path d="M56 160 L108 136 L160 146 L212 106 L264 120 L316 76 L368 92 L404 52" fill="none" />
          <path class="area" d="M56 160 L108 136 L160 146 L212 106 L264 120 L316 76 L368 92 L404 52 L404 182 L56 182 Z" fill="url(#phvArea)" />
          <path class="line" d="M56 160 L108 136 L160 146 L212 106 L264 120 L316 76 L368 92 L404 52" fill="none" stroke="var(--brand)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          {[[108,136],[212,106],[316,76],[404,52]].map(([cx, cy]) => (
            <circle cx={cx} cy={cy} r="4.5" fill="#fff" stroke="var(--brand)" stroke-width="2.5" />
          ))}
          <circle class="pulse" cx="404" cy="52" r="8" fill="var(--brand)" opacity="0.28" />
        </g>
      </g>
    )}

    {variant === 'whyus' && (
      <g>
        <text x="40" y="46" class="lbl">TIME TO PRODUCTION</text>
        <line x1="40" y1="72" x2="420" y2="72" stroke="var(--border-strong)" stroke-dasharray="4 5" />
        {[
          { x: 62, h: 74, red: true, t: 'ACEPOINTE' },
          { x: 166, h: 168, red: false, t: 'INTEGRATORS' },
          { x: 258, h: 138, red: false, t: 'PLATFORMS' },
          { x: 350, h: 196, red: false, t: 'STAFFING' },
        ].map((b) => (
          <g>
            <rect x={b.x} y={330 - b.h} width="58" height={b.h} rx="8" fill={b.red ? 'var(--brand)' : 'var(--brand-tint)'} stroke={b.red ? 'none' : 'var(--border-strong)'} />
            {b.red && <text x={b.x + 29} y={330 - b.h - 12} class="badge" text-anchor="middle">FASTEST</text>}
            <text x={b.x + 29} y="352" class="tick" text-anchor="middle">{b.t}</text>
          </g>
        ))}
        <line x1="40" y1="330" x2="420" y2="330" stroke="var(--border-strong)" />
      </g>
    )}

    {variant === 'approach' && (
      <g>
        {[
          { x: 28, y: 250, n: '01', t: 'Embed' },
          { x: 140, y: 152, n: '02', t: 'Build & ship' },
          { x: 252, y: 54, n: '03', t: 'Transfer' },
        ].map((s) => (
          <g transform={`translate(${s.x} ${s.y})`}>
            <rect width="180" height="96" rx="14" fill="var(--brand-tint)" />
            <rect width="180" height="96" rx="14" fill="none" stroke="var(--brand)" stroke-opacity="0.14" />
            <text x="20" y="42" class="step-n">{s.n}</text>
            <text x="20" y="72" class="step-t">{s.t}</text>
          </g>
        ))}
        {/* ascending connectors */}
        <path d="M208 274 C 236 274, 220 210, 252 200" stroke="var(--brand)" stroke-opacity="0.5" stroke-width="2" stroke-dasharray="3 4" fill="none" marker-end="url(#phvArrow)" />
        <path d="M320 176 C 348 176, 332 112, 364 102" stroke="var(--brand)" stroke-opacity="0.5" stroke-width="2" stroke-dasharray="3 4" fill="none" marker-end="url(#phvArrow)" />
        <defs>
          <marker id="phvArrow" markerWidth="7" markerHeight="7" refX="3.5" refY="3.5" orient="auto">
            <path d="M0 0 L7 3.5 L0 7 z" fill="var(--brand)" opacity="0.6" />
          </marker>
        </defs>
      </g>
    )}
  </svg>
</div>

<style>
  .phv {
    width: 100%;
    max-width: 460px;
    margin-inline: auto;
  }
  .phv svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .lbl {
    fill: var(--ink);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.06em;
  }
  .lbl-lg {
    fill: var(--brand);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
  }
  .step-n {
    fill: var(--brand);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
  }
  .step-t {
    fill: var(--ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
  }
  .metric {
    fill: var(--brand);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 25px;
  }
  .cap {
    fill: var(--muted);
    font-family: var(--font-body);
    font-size: 10.5px;
  }
  .tick {
    fill: var(--muted);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.05em;
  }
  .badge {
    fill: var(--brand);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.07em;
  }
  .pulse {
    animation: phv-pulse 2.4s ease-in-out infinite;
    transform-origin: 404px 202px;
  }
  @keyframes phv-pulse {
    0%, 100% { opacity: 0.28; transform: scale(1); }
    50% { opacity: 0.06; transform: scale(1.7); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pulse { animation: none; }
  }
</style>
