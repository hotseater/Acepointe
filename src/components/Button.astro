---
/**
 * Button — pill CTA. Renders <a> when `href` is set, else <button>.
 * variants: primary (red gradient) | secondary (bordered) | ghost-dark (on dark bands)
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'lg';
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  class: className = '',
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const attrs = href ? { href } : { type };
---

<Tag class:list={['btn', `btn--${variant}`, `btn--${size}`, className]} {...attrs} {...rest}>
  <slot />
</Tag>

<style>
  .btn {
    --btn-py: 16px;
    --btn-px: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 15.5px;
    letter-spacing: 0.04em;
    line-height: 1;
    padding: var(--btn-py) var(--btn-px);
    border: 2px solid transparent;
    border-radius: var(--radius-pill);
    cursor: pointer;
    text-align: center;
    transition:
      transform var(--dur-fast) ease,
      border-color var(--dur-fast) ease,
      color var(--dur-fast) ease,
      box-shadow var(--dur-fast) ease;
  }

  .btn--md {
    --btn-py: 11px;
    --btn-px: 24px;
    font-size: 14px;
  }
  .btn--lg {
    --btn-py: 16px;
    --btn-px: 36px;
    font-size: 15.5px;
  }

  .btn--primary {
    background: var(--brand-gradient);
    color: #fff;
    box-shadow: var(--shadow-cta);
  }
  .btn--md.btn--primary {
    box-shadow: var(--shadow-cta-sm);
  }
  .btn--primary:hover {
    color: #fff;
    transform: translateY(-2px);
  }

  .btn--secondary {
    background: transparent;
    color: var(--ink);
    border-color: var(--border-strong);
  }
  .btn--secondary:hover {
    color: var(--brand);
    border-color: var(--brand);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn:hover {
      transform: none;
    }
  }
</style>
