---
import { site, nav, socials } from '../config';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <span class="footer__word">{site.name}</span>
      <p class="footer__tag">{site.tagline}</p>
    </div>

    <nav class="footer__nav" aria-label="Footer">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="footer__social">
      {
        socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer">
            {s.label}
          </a>
        ))
      }
    </div>
  </div>

  <div class="container footer__legal">
    <span>&copy; {year} {site.name}</span>
    <div class="footer__legal-links">
      <a href="/privacy">Privacy Policy</a>
      <a href="/terms">Terms</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--dark);
    color: var(--on-dark);
    padding-block: var(--space-2xl) var(--space-lg);
    margin-top: var(--space-3xl);
  }
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .footer__word {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 22px;
  }
  .footer__tag {
    color: var(--on-dark-muted);
    font-size: 14px;
    margin-top: 6px;
    max-width: 34ch;
  }
  .footer__nav,
  .footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    align-items: center;
    font-size: 14px;
  }
  .footer a {
    color: var(--on-dark-muted);
  }
  .footer a:hover {
    color: var(--on-dark);
  }
  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-top: var(--space-lg);
    font-size: 13.5px;
    color: rgba(255, 255, 255, 0.5);
  }
  .footer__legal-links {
    display: flex;
    gap: 22px;
  }

  @media (max-width: 640px) {
    .footer__inner {
      flex-direction: column;
      gap: var(--space-lg);
    }
  }
</style>
