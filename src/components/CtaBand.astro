---
import Button from './Button.astro';
/** Dark call-to-action band used at the foot of inner pages. */
interface Props {
  secondaryHref?: string;
  secondaryLabel?: string;
}
const { secondaryHref, secondaryLabel } = Astro.props;
---

<section class="cta-band">
  <div class="container cta-band__inner">
    <div class="cta-band__copy" data-reveal="left">
      <h2><slot name="title" /></h2>
      <p><slot name="text" /></p>
    </div>
    <div class="cta-band__actions" data-reveal>
      {secondaryHref && (
        <a class="cta-band__secondary" href={secondaryHref}>{secondaryLabel}</a>
      )}
      <Button href="/contact" variant="primary" size="lg">GET IN TOUCH</Button>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--dark);
    color: var(--on-dark);
    margin-top: var(--space-3xl);
  }
  /* Soft brand glow so the dark band reads rich, not flat. */
  .cta-band::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      ellipse 42% 120% at 88% 40%,
      color-mix(in srgb, var(--brand) 38%, transparent),
      transparent 62%
    );
  }
  .cta-band__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
    padding-block: clamp(3rem, 2rem + 4vw, 4.5rem);
  }
  .cta-band__copy h2 {
    color: var(--on-dark);
    font-size: clamp(1.75rem, 1.3rem + 2vw, 2.4rem);
    letter-spacing: var(--tracking-display);
    margin: 0 0 10px;
  }
  .cta-band__copy p {
    font-size: 17px;
    line-height: 1.7;
    color: var(--on-dark-muted);
    margin: 0;
    max-width: 560px;
  }
  .cta-band__actions {
    display: flex;
    gap: 16px;
    flex-shrink: 0;
    align-items: center;
  }
  .cta-band__secondary {
    color: var(--on-dark);
    padding: 15px 30px;
    border-radius: var(--radius-pill);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.04em;
    border: 2px solid rgba(255, 255, 255, 0.35);
    white-space: nowrap;
    transition: border-color var(--dur) ease;
  }
  .cta-band__secondary:hover {
    border-color: #fff;
    color: #fff;
  }

  @media (max-width: 800px) {
    .cta-band__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 28px;
    }
    .cta-band__actions {
      width: 100%;
    }
  }
</style>
