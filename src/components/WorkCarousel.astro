---
import CaseCard from './CaseCard.astro';
import { caseStudies } from '../data/caseStudies';
---

<div class="carousel" data-carousel aria-roledescription="carousel" aria-label="Recent work">
  <div class="carousel__track" data-track tabindex="0">
    {caseStudies.map((study) => <CaseCard study={study} variant="carousel" />)}
  </div>

  <div class="carousel__controls">
    <button class="carousel__arrow" data-prev aria-label="Previous case study">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <div class="carousel__dots" role="tablist" aria-label="Choose case study">
      {caseStudies.map((study, i) => (
        <button
          class="carousel__dot"
          role="tab"
          data-dot={i}
          aria-label={`Show: ${study.title}`}
          aria-selected={i === 0 ? 'true' : 'false'}
        ></button>
      ))}
    </div>
    <button class="carousel__arrow" data-next aria-label="Next case study">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>
</div>

<style>
  .carousel {
    --case-w: min(480px, 84vw);
  }
  .carousel__track {
    display: flex;
    gap: 26px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 12px 4px 20px;
    margin: -12px -4px 0;
    scrollbar-width: none;
  }
  .carousel__track::-webkit-scrollbar {
    display: none;
  }
  .carousel__track :global(.case--carousel) {
    scroll-snap-align: start;
  }
  .carousel__track:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 4px;
    border-radius: var(--radius-lg);
  }

  .carousel__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 32px;
  }
  .carousel__arrow {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 2px solid var(--border-strong);
    background: var(--surface);
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      border-color var(--dur) ease,
      color var(--dur) ease,
      transform var(--dur) var(--ease-out-quart);
  }
  .carousel__arrow:hover {
    border-color: var(--brand);
    color: var(--brand);
    transform: translateY(-2px);
  }
  .carousel__dots {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .carousel__dot {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-pill);
    border: none;
    background: var(--border-strong);
    padding: 0;
    transition:
      width var(--dur) var(--ease-out-quart),
      background var(--dur) ease;
  }
  .carousel__dot[aria-selected='true'] {
    width: 28px;
    background: var(--brand);
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel__track {
      scroll-behavior: auto;
    }
    .carousel__arrow:hover {
      transform: none;
    }
  }
</style>

<script>
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-dot]'));
    const prev = root.querySelector<HTMLElement>('[data-prev]')!;
    const next = root.querySelector<HTMLElement>('[data-next]')!;

    const reals = Array.from(track.children) as HTMLElement[];
    const realCount = reals.length;
    if (realCount === 0) return;

    // Clone the set once so the strip can loop forward seamlessly (the clones
    // sit after the reals; when we glide onto the first clone we instantly hop
    // back to the real start — visually identical, so the reset is invisible).
    reals.forEach((c) => {
      const clone = c.cloneNode(true) as HTMLElement;
      clone.setAttribute('aria-hidden', 'true');
      clone.querySelectorAll('a').forEach((a) => a.setAttribute('tabindex', '-1'));
      // Clones are added AFTER the reveal/scene observers init, so they'd never
      // be observed — force them to their final visible state.
      clone.removeAttribute('data-reveal');
      clone.querySelectorAll('[data-reveal]').forEach((el) => el.removeAttribute('data-reveal'));
      clone.querySelectorAll<HTMLElement>('.scene').forEach((s) => s.classList.add('play'));
      track.appendChild(clone);
    });

    const gap = parseFloat(getComputedStyle(track).columnGap || '26') || 26;
    const step = () => (reals[0]?.getBoundingClientRect().width ?? 0) + gap;
    const setWidth = () => realCount * step();

    let i = 0; // logical position across the extended (reals + clones) track
    let timer: number | undefined;

    const jump = (left: number) => track.scrollTo({ left, behavior: 'auto' });
    const glide = (left: number) => track.scrollTo({ left, behavior: prefersReduced ? 'auto' : 'smooth' });

    const forward = () => {
      if (i >= realCount) { jump(0); i = 0; } // sitting on the first clone → reset seamlessly
      i += 1;
      glide(i * step());
    };
    const backward = () => {
      if (i <= 0) { jump(setWidth()); i = realCount; } // wrap to end seamlessly
      i -= 1;
      glide(i * step());
    };

    const setDots = () => {
      const active = ((Math.round(track.scrollLeft / step()) % realCount) + realCount) % realCount;
      dots.forEach((d, di) => d.setAttribute('aria-selected', di === active ? 'true' : 'false'));
    };

    let raf = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(setDots);
    });

    const stop = () => {
      if (timer) { clearInterval(timer); timer = undefined; }
    };
    const start = () => {
      if (prefersReduced || timer) return;
      timer = window.setInterval(forward, 5000);
    };

    prev.addEventListener('click', () => { stop(); backward(); });
    next.addEventListener('click', () => { stop(); forward(); });
    dots.forEach((dot, di) => dot.addEventListener('click', () => { stop(); i = di; glide(i * step()); }));

    // Pause on interaction; keyboard arrows on the focused track.
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); stop(); forward(); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); stop(); backward(); }
    });

    setDots();
    start();
  });
</script>
