---
import { compareRows, compareColumns } from '../data/compare';
const [siCol, platformCol, staffingCol] = compareColumns;
---

<div class="compare" data-reveal>
  <table class="compare__table">
    <caption class="sr-only">How AcePointe compares to alternative engagement models</caption>
    <thead>
      <tr>
        <td></td>
        <th scope="col" class="is-ace">AcePointe</th>
        <th scope="col">{siCol}</th>
        <th scope="col">{platformCol}</th>
        <th scope="col">{staffingCol}</th>
      </tr>
    </thead>
    <tbody>
      {
        compareRows.map((row) => (
          <tr>
            <th scope="row" class="compare__label">{row.label}</th>
            <td class="is-ace" data-vendor="AcePointe">{row.ace}</td>
            <td data-vendor={siCol}>{row.si}</td>
            <td data-vendor={platformCol}>{row.platform}</td>
            <td data-vendor={staffingCol}>{row.staffing}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
<p class="compare__note">Category comparison based on typical engagement models; individual firms vary.</p>

<style>
  .compare {
    border: 1px solid var(--border-table);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-top: 44px;
  }
  .compare__table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .compare__table th,
  .compare__table td {
    padding: 20px 22px;
    text-align: left;
    vertical-align: top;
    border: 1px solid var(--border-table);
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--body);
    font-weight: 400;
  }
  /* header row */
  thead td {
    border: 1px solid var(--border-table);
    background: var(--surface);
  }
  thead th {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    color: var(--ink);
    background: var(--surface);
  }
  /* row labels */
  .compare__label {
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 13.5px;
    color: var(--muted);
    background: var(--surface);
    width: 200px;
  }
  /* AcePointe column emphasis */
  .is-ace {
    background: var(--brand-tint) !important;
    color: var(--ink) !important;
    font-weight: 600 !important;
  }
  thead .is-ace {
    color: var(--brand) !important;
    font-family: var(--font-display);
    font-weight: 700 !important;
  }

  .compare__note {
    font-size: 13px;
    color: var(--muted);
    text-align: center;
    margin-top: 18px;
  }

  /* --- Mobile: stack each criteria into a card, vendors labelled --- */
  @media (max-width: 860px) {
    .compare {
      border: none;
      border-radius: 0;
      overflow: visible;
      margin-top: 32px;
    }
    .compare__table,
    .compare__table tbody,
    .compare__table tr,
    .compare__table td,
    .compare__label {
      display: block;
      width: auto;
    }
    .compare__table thead {
      display: none;
    }
    .compare__table tr {
      border: 1px solid var(--border-table);
      border-radius: var(--radius);
      overflow: hidden;
      margin-bottom: 18px;
    }
    .compare__label {
      background: var(--dark);
      color: var(--on-dark);
      font-size: 13px;
      border: none;
    }
    .compare__table td {
      border: none;
      border-top: 1px solid var(--border-table);
      padding-block: 14px;
    }
    .compare__table td::before {
      content: attr(data-vendor);
      display: block;
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 4px;
    }
    .is-ace::before {
      color: var(--brand) !important;
    }
  }
</style>
