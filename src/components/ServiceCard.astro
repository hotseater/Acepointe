---
import type { Service } from '../data/services';
interface Props {
  service: Service;
  index: number;
}
const { service, index } = Astro.props;
---

<article
  class:list={['service', { 'service--featured': service.featured }]}
  data-reveal
  style={`--reveal-delay:${(index % 3) * 90}ms`}
>
  <h3>{service.title}</h3>
  <p class="service__desc">{service.desc}</p>
  <div class="service__proof">
    <span class="service__tag">Example</span>
    <p>{service.example}</p>
  </div>
</article>

<style>
  .service {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 32px;
    transition:
      transform var(--dur) var(--ease-out-quart),
      box-shadow var(--dur) ease,
      border-color var(--dur) ease;
  }
  .service:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
    border-color: var(--brand);
  }

  /* Flagship services stand out within the uniform grid (breaks card monotony). */
  .service--featured {
    background: var(--brand-tint);
    border-color: color-mix(in srgb, var(--brand) 22%, var(--border));
  }

  h3 {
    font-size: 19px;
    color: var(--ink);
  }
  .service__desc {
    font-size: 15px;
    color: var(--body);
  }
  .service__proof {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--border);
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--body);
  }
  .service--featured .service__proof {
    border-top-color: color-mix(in srgb, var(--brand) 18%, transparent);
  }
  .service__tag {
    display: block;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 11.5px;
    color: var(--brand);
    margin-bottom: 4px;
  }
  .service__proof p {
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .service:hover {
      transform: none;
    }
  }
</style>
