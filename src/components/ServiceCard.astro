---
import type { Service } from '../data/services';
interface Props {
  service: Service;
  index: number;
}
const { service, index } = Astro.props;
const isSpotlight = Boolean(service.spotlight);
---

<article
  class:list={[
    'service',
    { 'service--featured': service.featured && !isSpotlight, 'service--spotlight': isSpotlight },
  ]}
  data-reveal
  style={`--reveal-delay:${isSpotlight ? 0 : (index % 3) * 90}ms`}
>
  <div class="service__main">
    <h3>
      {service.href ? <a class="service__title-link" href={service.href}>{service.title}</a> : service.title}
    </h3>
    <p class="service__desc">{service.desc}</p>
  </div>
  <div class="service__proof">
    <span class="service__tag">{isSpotlight ? 'What we deliver' : 'Example'}</span>
    <p>{service.example}</p>
    {
      service.href && (
        <a class="service__link" href={service.href}>
          {service.linkLabel ?? 'Learn more'}
          <span aria-hidden="true">&rarr;</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .service {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 32px;
    transition:
      transform var(--dur) var(--ease-out-quart),
      box-shadow var(--dur) ease,
      border-color var(--dur) ease;
  }
  .service:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
    border-color: var(--brand);
  }
  .service__main {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Flagship services stand out within the uniform grid (breaks card monotony). */
  .service--featured {
    background: var(--brand-tint);
    border-color: color-mix(in srgb, var(--brand) 22%, var(--border));
  }

  h3 {
    font-size: 19px;
    color: var(--ink);
  }
  .service__title-link {
    color: inherit;
  }
  .service__title-link:hover {
    color: var(--brand);
  }
  .service__desc {
    font-size: 15px;
    color: var(--body);
  }
  .service__proof {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--border);
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--body);
  }
  .service--featured .service__proof {
    border-top-color: color-mix(in srgb, var(--brand) 18%, transparent);
  }
  .service__tag {
    display: block;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 11.5px;
    color: var(--brand);
    margin-bottom: 4px;
  }
  .service__proof p {
    margin: 0;
  }
  .service__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    font-weight: 700;
    font-size: 14px;
    color: var(--brand);
  }
  .service__link span {
    transition: transform var(--dur-fast) ease;
  }
  .service__link:hover span {
    transform: translateX(3px);
  }

  /* Spotlight: a dark panel spanning the full grid row, matching the hero panel treatment. */
  .service--spotlight {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 40px 56px;
    align-items: start;
    padding: clamp(28px, 3vw, 40px);
    color: var(--on-dark-muted);
    background:
      radial-gradient(
        ellipse 46% 70% at 88% 30%,
        color-mix(in srgb, var(--brand) 42%, transparent),
        transparent 62%
      ),
      linear-gradient(158deg, #26121a 0%, #150b0f 100%);
    border-color: color-mix(in srgb, var(--brand) 32%, transparent);
  }
  .service--spotlight:hover {
    border-color: var(--brand);
    box-shadow: 0 18px 44px var(--brand-glow);
  }
  .service--spotlight h3 {
    color: var(--on-dark);
    font-size: clamp(1.4rem, 1.2rem + 1vw, 1.9rem);
    letter-spacing: var(--tracking-display);
  }
  .service--spotlight .service__title-link:hover {
    color: var(--brand-light);
  }
  .service--spotlight .service__desc {
    color: var(--on-dark-muted);
    font-size: 16px;
    line-height: 1.7;
  }
  .service--spotlight .service__proof {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
    padding-left: 24px;
    border-left: 2px solid color-mix(in srgb, var(--brand) 55%, transparent);
    color: var(--on-dark-muted);
    font-size: 14.5px;
  }
  .service--spotlight .service__tag {
    color: var(--brand-light);
  }
  .service--spotlight .service__link {
    color: #fff;
  }
  .service--spotlight .service__link:hover {
    color: var(--brand-light);
  }

  @media (max-width: 800px) {
    .service--spotlight {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .service--spotlight .service__proof {
      padding-left: 0;
      border-left: 0;
      padding-top: 20px;
      border-top: 1px solid rgba(255, 255, 255, 0.14);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service:hover {
      transform: none;
    }
    .service__link:hover span {
      transform: none;
    }
  }
</style>
