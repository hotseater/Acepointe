---
import { site } from '../config';
import SectionHeader from './SectionHeader.astro';

interface Props {
  /** Show the "What happens next" 1-2-3 steps (used on the /contact page). */
  showSteps?: boolean;
}
const { showSteps = false } = Astro.props;

const steps = [
  'A 30-minute call with a senior engineer about your goal and your environment.',
  'A written point of view: the shortest path to production, scoped around the outcome.',
  "If it's a fit, engineers embedded with your team — usually within two weeks.",
];
---

<section id="contact" class="contact section">
  <div class="container contact__grid">
    <div class="contact__intro" data-reveal="left">
      <SectionHeader>
        <Fragment slot="title">Ready to ship? <span class="accent">Let's talk.</span></Fragment>
      </SectionHeader>
      <p class="contact__copy">
        Tell us where you are and where you want to be. {showSteps ? 'A senior engineer — not a salesperson — will' : "We'll"}
        come back within one business day with a point of view.
      </p>
      <div class="contact__direct">
        <a href={site.phoneHref}>{site.phone}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
      {
        showSteps && (
          <div class="contact__next">
            <p class="contact__next-label">What happens next</p>
            <ol>
              {steps.map((s, i) => (
                <li>
                  <span class="contact__next-num">{i + 1}</span>
                  <span>{s}</span>
                </li>
              ))}
            </ol>
          </div>
        )
      }
    </div>

    <div class="contact__card" data-reveal>
      <form class="contact__form" aria-label="Contact AcePointe" data-contact-form novalidate>
        <p class="form__status" data-status role="alert" hidden></p>

        <div class="contact__row">
          <div class="field">
            <label for="c-name">Name</label>
            <input id="c-name" name="name" type="text" autocomplete="name" required aria-describedby="err-name" />
            <span class="field__err" id="err-name" data-err="name"></span>
          </div>
          <div class="field">
            <label for="c-email">Work email</label>
            <input id="c-email" name="email" type="email" autocomplete="email" required aria-describedby="err-email" />
            <span class="field__err" id="err-email" data-err="email"></span>
          </div>
        </div>

        <div class="field">
          <label for="c-company">Company</label>
          <input id="c-company" name="company" type="text" autocomplete="organization" />
        </div>

        <div class="field">
          <label for="c-message">What are you trying to solve?</label>
          <textarea id="c-message" name="message" rows="5" required aria-describedby="err-message"></textarea>
          <span class="field__err" id="err-message" data-err="message"></span>
        </div>

        <!-- Bot traps: honeypot (hidden from users) + render timestamp -->
        <div class="hp" aria-hidden="true">
          <label>Leave this field empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <input type="hidden" name="_ts" data-ts />

        <button type="submit" class="contact__submit" data-submit>
          <span data-submit-label>GET IN TOUCH</span>
        </button>
      </form>

      <div class="form__success" data-success hidden tabindex="-1">
        <div class="form__success-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="26" height="26"><path d="M5 13l4 4L19 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <h3>Thanks — we've got it.</h3>
        <p>
          We'll come back within one business day. Prefer to talk now? Call{' '}
          <a href={site.phoneHref}>{site.phone}</a>.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: start;
  }
  .contact__intro {
    padding-top: 12px;
  }
  .contact__copy {
    font-size: 17px;
    color: var(--body);
    max-width: 44ch;
    margin: 22px 0 32px;
  }
  .contact__direct {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 17px;
    font-weight: 700;
  }
  .contact__direct a {
    color: var(--ink);
    width: fit-content;
  }
  .contact__direct a:hover {
    color: var(--brand);
  }

  .contact__next {
    margin-top: 44px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  .contact__next-label {
    font-size: 12px;
    letter-spacing: 0.14em;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 18px;
  }
  .contact__next ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .contact__next li {
    display: flex;
    gap: 14px;
    align-items: baseline;
    font-size: 15px;
    line-height: 1.6;
  }
  .contact__next-num {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--brand);
    font-size: 15px;
    flex-shrink: 0;
  }

  .contact__card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 38px;
    box-shadow: var(--shadow-form);
  }
  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  /* `hidden` attribute must win over the flex display above. */
  .contact__form[hidden] {
    display: none;
  }
  .contact__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .field label {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
  }
  .field input,
  .field textarea {
    background: #f7f7f9;
    border: 1px solid var(--border-input);
    border-radius: var(--radius-sm);
    padding: 13px 16px;
    color: var(--ink);
    font-size: 15px;
    outline: none;
    transition:
      border-color var(--dur) ease,
      box-shadow var(--dur) ease;
  }
  .field input:focus,
  .field textarea:focus {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand) 14%, transparent);
  }
  .field textarea {
    resize: vertical;
    min-height: 120px;
  }
  .field input[aria-invalid='true'],
  .field textarea[aria-invalid='true'] {
    border-color: var(--brand);
    background: color-mix(in srgb, var(--brand) 4%, #f7f7f9);
  }
  .field__err {
    font-size: 12.5px;
    color: var(--brand);
    min-height: 0;
  }
  .field__err:empty {
    display: none;
  }

  .form__status {
    background: color-mix(in srgb, var(--brand) 8%, #fff);
    border: 1px solid color-mix(in srgb, var(--brand) 30%, transparent);
    color: var(--brand-deep);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    font-size: 14px;
    font-weight: 600;
  }

  /* Honeypot — off-screen, non-focusable, invisible to users. */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact__submit {
    background: var(--brand-gradient);
    color: #fff;
    border: none;
    padding: 16px;
    border-radius: var(--radius-pill);
    font-size: 15.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    box-shadow: var(--shadow-cta);
    transition:
      transform var(--dur-fast) ease,
      opacity var(--dur) ease;
    margin-top: 4px;
  }
  .contact__submit:hover {
    transform: translateY(-1px);
  }
  .contact__submit[disabled] {
    opacity: 0.7;
    cursor: progress;
    transform: none;
  }

  .form__success {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 8px 0;
    animation: success-in 0.5s var(--ease-out-expo);
  }
  .form__success[hidden] {
    display: none;
  }
  .form__success-mark {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #fff;
    background: var(--brand-gradient);
    box-shadow: var(--shadow-cta-sm);
  }
  .form__success h3 {
    font-size: 22px;
    color: var(--ink);
  }
  .form__success p {
    font-size: 15.5px;
    color: var(--body);
  }
  @keyframes success-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @media (max-width: 860px) {
    .contact__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
  @media (max-width: 480px) {
    .contact__row {
      grid-template-columns: 1fr;
    }
    .contact__card {
      padding: 26px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact__submit:hover {
      transform: none;
    }
    .form__success {
      animation: none;
    }
  }
</style>

<script>
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const card = form.closest('.contact__card')!;
    const statusEl = form.querySelector<HTMLElement>('[data-status]')!;
    const success = card.querySelector<HTMLElement>('[data-success]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const tsField = form.querySelector<HTMLInputElement>('[data-ts]')!;
    tsField.value = String(Date.now());

    const fields = ['name', 'email', 'message'] as const;

    const showError = (key: string, msg: string) => {
      const errEl = form.querySelector<HTMLElement>(`[data-err="${key}"]`);
      const input = form.querySelector<HTMLElement>(`[name="${key}"]`);
      if (errEl) errEl.textContent = msg;
      if (input) input.setAttribute('aria-invalid', 'true');
    };
    const clearErrors = () => {
      form.querySelectorAll<HTMLElement>('[data-err]').forEach((e) => (e.textContent = ''));
      form.querySelectorAll('[aria-invalid]').forEach((e) => e.removeAttribute('aria-invalid'));
      statusEl.hidden = true;
      statusEl.textContent = '';
    };
    const setStatus = (msg: string) => {
      statusEl.textContent = msg;
      statusEl.hidden = false;
    };

    const validate = (data: Record<string, string>) => {
      const errors: Record<string, string> = {};
      if (!data.name?.trim()) errors.name = 'Please enter your name.';
      if (!data.email?.trim()) errors.email = 'Please enter your work email.';
      else if (!EMAIL_RE.test(data.email.trim())) errors.email = 'Please enter a valid email address.';
      if (!data.message?.trim()) errors.message = 'Tell us a little about what you need.';
      return errors;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearErrors();
      const fd = new FormData(form);
      const data = Object.fromEntries(fd) as Record<string, string>;

      const errors = validate(data);
      if (Object.keys(errors).length) {
        Object.entries(errors).forEach(([k, m]) => showError(k, m));
        form.querySelector<HTMLElement>(`[name="${Object.keys(errors)[0]}"]`)?.focus();
        return;
      }

      submit.disabled = true;
      label.textContent = 'Sending…';
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(data),
        });
        const body = await res.json().catch(() => ({}));
        if (res.ok && body.ok) {
          form.hidden = true;
          success.hidden = false;
          success.focus();
          return;
        }
        if (body.errors) {
          Object.entries(body.errors).forEach(([k, m]) => showError(k, String(m)));
          form.querySelector<HTMLElement>(`[name="${Object.keys(body.errors)[0]}"]`)?.focus();
        } else {
          setStatus(body.error || 'Something went wrong. Please email info@acepointe.com.');
        }
      } catch {
        setStatus('Network error — please check your connection or email info@acepointe.com.');
      } finally {
        submit.disabled = false;
        label.textContent = 'GET IN TOUCH';
      }
    });

    // Clear a field's error as the user corrects it.
    fields.forEach((key) => {
      form.querySelector(`[name="${key}"]`)?.addEventListener('input', (ev) => {
        const t = ev.target as HTMLElement;
        if (t.getAttribute('aria-invalid') === 'true') {
          t.removeAttribute('aria-invalid');
          const errEl = form.querySelector<HTMLElement>(`[data-err="${key}"]`);
          if (errEl) errEl.textContent = '';
        }
      });
    });
  });
</script>
