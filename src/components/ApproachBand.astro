---
const steps = [
  {
    n: '01',
    title: 'Embed',
    body: 'Our forward-deployed engineers join your team on day one — inside your tools, your data, and your constraints. No slide-deck consulting.',
  },
  {
    n: '02',
    title: 'Build & ship',
    body: 'We ship working software early and iterate in production — data platforms, AI systems, and the applications that put them to work.',
  },
  {
    n: '03',
    title: 'Transfer',
    body: "We leave your team able to run it without us — documented, governed, and maintainable. Success is when you don't need us anymore.",
  },
];
---

<section id="approach" class="approach">
  <div class="container">
    <h2 class="approach__title" data-reveal>How we work</h2>
    <ol class="approach__grid">
      {
        steps.map((step, i) => (
          <li class="step" data-reveal style={`--reveal-delay:${i * 120}ms`}>
            <span class="step__n">{step.n}</span>
            <h3 class="step__title">{step.title}</h3>
            <p class="step__body">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .approach {
    background: var(--brand-tint);
    color: var(--ink);
    border-block: 1px solid var(--border);
    padding-block: clamp(4rem, 3rem + 4vw, 5.6rem);
    margin-block: var(--space-3xl);
  }
  .approach__title {
    color: var(--ink);
    font-size: var(--step-3);
    letter-spacing: var(--tracking-display);
    margin-bottom: 3.5rem;
  }
  .approach__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
    counter-reset: none;
  }
  .step__n {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    color: var(--brand);
    margin-bottom: 12px;
  }
  .step__title {
    color: var(--ink);
    font-size: 21px;
    margin-bottom: 12px;
  }
  .step__body {
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--body);
  }

  @media (max-width: 820px) {
    .approach__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
