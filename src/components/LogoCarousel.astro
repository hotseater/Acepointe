---
import { Image } from 'astro:assets';
import { clients } from '../data/clients';
---

<div class="logos" data-logos>
  <p class="logos__label">Trusted by teams<br />across industries</p>
  <button class="logos__arrow" data-lprev aria-label="Previous logos">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <ul class="logos__track" data-ltrack>
    {
      clients.map((client) => (
        <li class="logos__tile">
          <Image src={client.logo} alt={client.name} height={52} loading="lazy" />
        </li>
      ))
    }
  </ul>
  <button class="logos__arrow" data-lnext aria-label="Next logos">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
</div>

<style>
  .logos {
    display: flex;
    align-items: center;
    gap: 20px;
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding: 28px var(--gutter);
    max-width: var(--container);
    margin-inline: auto;
  }
  .logos__label {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--muted);
    flex-shrink: 0;
    line-height: 1.4;
  }
  .logos__track {
    display: flex;
    gap: 32px;
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    list-style: none;
    margin: 0;
    padding: 0;
    scrollbar-width: none;
  }
  .logos__track::-webkit-scrollbar {
    display: none;
  }
  .logos__tile {
    flex: 0 0 clamp(150px, 22vw, 220px);
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    scroll-snap-align: start;
  }
  .logos__tile :global(img) {
    width: auto;
    max-width: 100%;
    max-height: 52px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.6;
    transition:
      filter var(--dur) ease,
      opacity var(--dur) ease;
  }
  .logos__tile:hover :global(img) {
    filter: none;
    opacity: 1;
  }
  .logos__arrow {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--body);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition:
      border-color var(--dur) ease,
      color var(--dur) ease;
  }
  .logos__arrow:hover {
    border-color: var(--brand);
    color: var(--brand);
  }

  @media (max-width: 720px) {
    .logos {
      flex-wrap: wrap;
    }
    .logos__label {
      flex: 1 1 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .logos__track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-logos]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-ltrack]')!;
    const step = () => (track.querySelector<HTMLElement>('.logos__tile')?.offsetWidth ?? 180) + 32;
    let timer: number | undefined;

    const go = (dir: number) => {
      const max = track.scrollWidth - track.clientWidth;
      let nextLeft = track.scrollLeft + dir * step();
      if (nextLeft > max - 4) nextLeft = 0;
      else if (nextLeft < 0) nextLeft = max;
      track.scrollTo({ left: nextLeft });
    };

    const stop = () => { if (timer) { clearInterval(timer); timer = undefined; } };
    const start = () => {
      if (prefersReduced || timer) return;
      timer = window.setInterval(() => go(1), 3500);
    };

    root.querySelector('[data-lprev]')!.addEventListener('click', () => { stop(); go(-1); });
    root.querySelector('[data-lnext]')!.addEventListener('click', () => { stop(); go(1); });
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    start();
  });
</script>
