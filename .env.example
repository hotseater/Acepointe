# AcePointe contact form delivery — copy to `.env` and fill in.
# With NONE set, the form still works in dev (logs the lead to the server console).

# --- HubSpot (Forms API — no private-app token needed) ---
# Portal/Hub ID (Settings ▸ Account Setup ▸ Account Defaults) and the form GUID
# of a HubSpot form whose fields include: firstname, email, company, message.
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=

# --- Resend (email notification / backup) ---
# Requires a verified sending domain for acepointe.com.
RESEND_API_KEY=
CONTACT_FROM="AcePointe Site <noreply@acepointe.com>"
CONTACT_TO=info@acepointe.com
