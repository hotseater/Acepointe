# AcePointe contact form — emails each submission via Resend.
# Set these in Vercel → Project → Settings → Environment Variables.
# With RESEND_API_KEY unset, the form still works in dev (logs the lead to the console).

# Resend API key (https://resend.com → API Keys). You already use Resend for NookTek.
RESEND_API_KEY=

# Who receives the lead emails.
CONTACT_TO=admin@nooktek.com

# From address — its DOMAIN must be verified in Resend.
# Use a verified domain: acepointe.com (verify it in Resend) or a nooktek.com sender.
CONTACT_FROM="AcePointe Website <noreply@acepointe.com>"

# /brightcover — private case page shown to prospects. One word, sent with the link.
# With this UNSET the page refuses to open at all (fails closed). Set in Vercel and redeploy.
BRIGHTCOVER_PAGE_PASSWORD=

# The word for acepointe.com/forward-deployed, the second sales film's private
# page. Same arrangement as BRIGHTCOVER_PAGE_PASSWORD: unset means the page
# refuses to open rather than falling open.
FORWARD_DEPLOYED_PAGE_PASSWORD=
